# Environment Configuration
NODE_ENV=production
PORT=10000

# Database - MongoDB Atlas (configurar en Render dashboard)
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@cluster0.xxxxx.mongodb.net/mente_sana?retryWrites=true&w=majority

# JWT - Clave segura para producción
JWT_SECRET=tu_clave_jwt_segura_para_produccion_min_32_caracteres
JWT_EXPIRE=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS - Vercel URL
CORS_ORIGIN=https://mente-sana.vercel.app

# Encryption - Clave segura para producción
ENCRYPTION_KEY=tu_clave_encriptacion_32_caracteres_segura_para_prod

# Analytics - Opcional
ANALYTICS_ENABLED=true
ANALYTICS_TRACKING_ID=tu_analytics_id